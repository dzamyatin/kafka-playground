### Create a new PROTOBUF schema
POST http://localhost:8185/subjects/prototest-value/versions
Content-Type: application/vnd.schemaregistry.v1+json

{
  "schemaType": "PROTOBUF",
  "schema": "syntax=\"proto3\";\n\npackage pim;\n\noption php_namespace = \"Service\\\\Protobuf\\\\Product\";\noption php_metadata_namespace = \"Service\\\\Protobuf\\\\GPBMetadata\\\\Product\";\n\nmessage Product {\n  oneof event {\n    Created created = 1;\n    Updated updated = 2;\n  }\n\n  message Created {\n    string uuid = 1; // uuid номенклатуры erp\n    string image = 2; // основное изображение товара\n    repeated string gallery = 3; // массив дополнительных изображений товара\n    Content content = 4; // набор контентных полей\n    string code = 5; // код номенклатуры erp\n  }\n\n  message Updated {\n    string uuid = 1;\n    string image = 2;\n    repeated string gallery = 3;\n    Content content = 4;\n    string code = 5;\n  }\n\n  message Content {\n    optional string short_desc = 1;\n    optional string composition = 2;\n    optional string component_properties = 3;\n    optional string nutritional_value = 4;\n    optional string pharm_group = 5;\n    optional string atc_code = 6;\n    optional string nosological_classification = 7;\n    optional string device_type = 8;\n    optional string lens_type = 9;\n    optional string characteristic = 10;\n    optional string functional_features = 11;\n    optional string description = 12;\n    optional string appointment = 13;\n    optional string body_effect = 14;\n    optional string pharm_effect = 15;\n    optional string directions = 16;\n    optional string result = 17;\n    optional string pregnancy_use = 18;\n    optional string contraindications = 19;\n    optional string side_effect = 20;\n    optional string overdose = 21;\n    optional string interaction = 22;\n    optional string dosing = 23;\n    optional string recommendations = 24;\n    optional string instructions = 25;\n    optional string special_instructions = 26;\n    optional string form = 27;\n    optional string size = 28;\n    optional string size_selection = 29;\n    optional string size_dimensions = 30;\n    optional string options = 31;\n    optional string package_count = 32;\n    optional string shelf_life = 33;\n    optional string conditions = 34;\n    map<string, string> aggregate_fields = 35;\n  }\n}"
}
